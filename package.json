{
  "name": "@casadi/casadi-reader",
  "version": "0.1.0",
  "description": "Read CasADi serialization as typed fields and shared references, without CasADi",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "casadi-reader": "bin/casadi-reader.js"
  },
  "files": [
    "dist/index.js",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "LICENSES"
  ],
  "scripts": {
    "generate": "python3 scripts/generate-reader-assets.py",
    "check:generated": "python3 scripts/generate-reader-assets.py --check",
    "build": "npm run generate && node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "node test/package-browser.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/casadi/casadi-reader.git"
  },
  "unpkg": "./dist/index.js",
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  }
}
