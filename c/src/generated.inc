    if (!strcmp(type, "std::vector<char>")) return read_std_vector_char(d);
    if (!strcmp(type, "std::vector<bool>")) return read_std_vector_bool(d);
    if (!strcmp(type, "std::vector<SXElem>")) return read_std_vector_SXElem(d);
    if (!strcmp(type, "std::vector<std::vector<int>>")) return read_std_vector_std_vector_int(d);
    if (!strcmp(type, "std::vector<unsignedint>")) return read_std_vector_unsignedint(d);
    if (!strcmp(type, "std::vector<size_t>")) return read_std_vector_size_t(d);
    if (!strcmp(type, "std::vector<Sparsity>")) return read_std_vector_Sparsity(d);
    if (!strcmp(type, "std::map<std::string,std::vector<size_t>>")) return read_std_map_std_string_std_vector_size_t(d);
    if (!strcmp(type, "std::vector<std::vector<size_t>>")) return read_std_vector_std_vector_size_t(d);
    if (!strcmp(type, "std::vector<Function>")) return read_std_vector_Function(d);
    if (!strcmp(type, "std::pair<casadi_int,std::string>")) return read_std_pair_casadi_int_std_string(d);
    if (!strcmp(type, "std::map<std::string,std::pair<casadi_int,std::string>>")) return read_std_map_std_string_std_pair_casadi_int_std_string(d);
    if (!strcmp(type, "std::pair<bool,std::string>")) return read_std_pair_bool_std_string(d);
    if (!strcmp(type, "std::map<std::string,std::pair<bool,std::string>>")) return read_std_map_std_string_std_pair_bool_std_string(d);
    if (!strcmp(type, "std::vector<MX>")) return read_std_vector_MX(d);
    if (!strcmp(type, "std::map<std::string,std::vector<double>>")) return read_std_map_std_string_std_vector_double(d);
    if (!strcmp(type, "std::map<std::string,casadi_int>")) return read_std_map_std_string_casadi_int(d);
    if (!strcmp(type, "std::map<std::string,std::vector<casadi_int>>")) return read_std_map_std_string_std_vector_casadi_int(d);
    if (!strcmp(type, "std::map<std::string,bool>")) return read_std_map_std_string_bool(d);
    if (!strcmp(type, "std::map<std::string,double>")) return read_std_map_std_string_double(d);
    if (!strcmp(type, "std::vector<SX>")) return read_std_vector_SX(d);
    if (!strcmp(type, "std::vector<std::vector<casadi_int>>")) return read_std_vector_std_vector_casadi_int(d);
    if (!strcmp(type, "std::vector<std::vector<std::string>>")) return read_std_vector_std_vector_std_string(d);
