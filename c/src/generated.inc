    if (!strcmp(type, "Function")) return read_Function(d);
    if (!strcmp(type, "GenericType")) return read_GenericType(d);
    if (!strcmp(type, "IM")) return read_IM(d);
    if (!strcmp(type, "Importer")) return read_Importer(d);
    if (!strcmp(type, "Linsol")) return read_Linsol(d);
    if (!strcmp(type, "MX")) return read_MX(d);
    if (!strcmp(type, "Resource")) return read_Resource(d);
    if (!strcmp(type, "SX")) return read_SX(d);
    if (!strcmp(type, "SXElem")) return read_SXElem(d);
    if (!strcmp(type, "Slice")) return read_Slice(d);
    if (!strcmp(type, "Sparsity")) return read_Sparsity(d);
    if (!strcmp(type, "std::vector<double>")) return read_std_vector_double(d);
    if (!strcmp(type, "std::vector<casadi_int>")) return read_std_vector_casadi_int(d);
    if (!strcmp(type, "std::vector<std::vector<double>>")) return read_std_vector_std_vector_double(d);
    if (!strcmp(type, "std::vector<std::string>")) return read_std_vector_std_string(d);
